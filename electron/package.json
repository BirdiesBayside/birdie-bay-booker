{
  "name": "birdies-bay-controller",
  "version": "1.0.4",
  "description": "Bay Controller for Birdies Golf Simulators",
  "main": "main.js",
  "author": "Birdies",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.birdies.baycontroller",
    "productName": "Birdies Bay Controller",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../dist-electron-app",
        "to": "dist",
        "filter": ["**/*"]
      },
      {
        "from": "tapo_control.exe",
        "to": "tapo_control.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "tp-link-tapo-connect": "^1.0.7",
    "uuid": "^9.0.0"
  }
}
